{
  "name": "dsh-client-ui-hawk-hq",
  "version": "0.2.0",
  "description": "Out-of-tree dsh plugin: sidebar GPU tracker (AMD/rocm-smi) with a ComfyUI panel that names the models resident in VRAM, harness version badge with an update check, and three settings pages — GPU watchdog, notification inbox, and an API spend/token dashboard.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "deepseek",
    "settings",
    "hawk",
    "gpu",
    "dashboard"
  ],
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node test/semver.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "tsdown": "^0.15.0",
    "typescript": "^5.7.2"
  },
  "author": "Bitcopath (https://github.com/bitcopath)",
  "homepage": "https://github.com/bitcopath/dsh-plugins/tree/main/plugins/dsh-client-ui-hawk-hq#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitcopath/dsh-plugins.git",
    "directory": "plugins/dsh-client-ui-hawk-hq"
  },
  "bugs": {
    "url": "https://github.com/bitcopath/dsh-plugins/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
